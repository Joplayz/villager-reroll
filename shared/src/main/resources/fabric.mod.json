{
  "schemaVersion": 1,
  "id": "villager-reroll",
  "version": "${version}",
  "name": "Villager Trade Reroller",
  "description": "Search villager trades with saved targets, pause/resume and a compact movable HUD.",
  "authors": [
    "joplayx"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/villager-reroll/icon.png",
  "environment": "client",
  "accessWidener": "villager-reroll.accesswidener",
  "entrypoints": {
    "main": [
      "com.joplayx.VillagerReroll"
    ],
    "client": [
      "com.joplayx.client.VillagerRerollClient"
    ],
    "modmenu": [
      "com.joplayx.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "villager-reroll.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"
